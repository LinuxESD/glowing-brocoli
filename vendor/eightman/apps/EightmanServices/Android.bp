    android_app {
        name: "EightmanServices",
        certificate: "platform", // to be persistent    
        system_ext_specific: true,
        platform_apis: true,
     
        static_libs: [
            "vendor.eightman.cpu-V1-java",
            "androidx-constraintlayout_constraintlayout",
            "androidx-constraintlayout_constraintlayout-solver",
        ],
     
        resource_dirs: ["res"],
     
        srcs: [
            "src/java/**/*.java",
        ],
    }
