    type hal_cpu_default, domain;
    type hal_cpu_default_exec, exec_type, vendor_file_type, file_type;
     
    init_daemon_domain(hal_cpu_default);
    vndbinder_use(hal_cpu_default);
    allow hal_cpu_default servicemanager:binder { call transfer };
    allow hal_cpu_default cpu_service:service_manager add;
